<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Autômato de Pilha (PDA) — Determinístico
  Problema: Reconhecimento de L = {a^n b^n | n >= 1}
  AV2 — Teoria da Computabilidade — CESUPA 01/2026

  Para abrir: JFLAP > File > Open > anbn.jff
  Para testar: Input > Enter Input
  Para rastrear: Input > Step by State

  Formato das transições no JFLAP:
    <read>  = símbolo lido da entrada (vazio = ε)
    <pop>   = símbolo desempilhado (topo exigido)
    <push>  = símbolo(s) empilhado(s) após pop
-->
<structure>
  <type>pda</type>
  <automaton>

    <!-- ESTADOS -->
    <state id="0" name="q0" x="80"  y="200">
      <initial/>
    </state>
    <state id="1" name="q1" x="240" y="200"/>
    <state id="2" name="q2" x="400" y="200"/>
    <state id="3" name="q3" x="560" y="200"/>
    <state id="4" name="q4" x="560" y="340"/>
    <state id="5" name="q5" x="720" y="200"/>
    <state id="6" name="q6" x="720" y="340"/>
    <state id="7" name="q7" x="880" y="200"/>
    <state id="8" name="q8" x="880" y="340"/>
    <state id="9" name="q_aceita" x="1040" y="200">
      <final/>
    </state>
    <state id="10" name="q_rejeita" x="400" y="400"/>

    <!-- =====================================================
         FASE 1: Empilhamento
         Para cada 'a' lido, empilha A.
         Usa estados intermediários para garantir >8 estados.
         ===================================================== -->

    <!-- q0: lê 1º 'a', topo=Z → empilha AZ, vai para q1 -->
    <transition>
      <from>0</from>
      <to>1</to>
      <read>a</read>
      <pop>Z</pop>
      <push>AZ</push>
    </transition>

    <!-- q0: lê 'b' diretamente → rejeita (sem nenhum 'a') -->
    <transition>
      <from>0</from>
      <to>10</to>
      <read>b</read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

    <!-- q1: lê 2º 'a', topo=A → empilha AA, vai para q2 -->
    <transition>
      <from>1</from>
      <to>2</to>
      <read>a</read>
      <pop>A</pop>
      <push>AA</push>
    </transition>

    <!-- q1: lê 'b' logo após 1 'a' → desempilha A, vai para q4 (n=1) -->
    <transition>
      <from>1</from>
      <to>4</to>
      <read>b</read>
      <pop>A</pop>
      <push></push>
    </transition>

    <!-- q2: lê mais 'a's, topo=A → loop empilhando A -->
    <transition>
      <from>2</from>
      <to>2</to>
      <read>a</read>
      <pop>A</pop>
      <push>AA</push>
    </transition>

    <!-- q2: lê 1º 'b' → desempilha, vai para q3 -->
    <transition>
      <from>2</from>
      <to>3</to>
      <read>b</read>
      <pop>A</pop>
      <push></push>
    </transition>

    <!-- =====================================================
         FASE 2: Desempilhamento
         Para cada 'b' lido, desempilha um A.
         ===================================================== -->

    <!-- q3: lê 'b', topo=A → desempilha -->
    <transition>
      <from>3</from>
      <to>3</to>
      <read>b</read>
      <pop>A</pop>
      <push></push>
    </transition>

    <!-- q3: mais 'a' na fase de desempilhamento → rejeita -->
    <transition>
      <from>3</from>
      <to>10</to>
      <read>a</read>
      <pop>A</pop>
      <push>A</push>
    </transition>

    <!-- q3: mais 'b' mas pilha zerou → rejeita (mais b que a) -->
    <transition>
      <from>3</from>
      <to>10</to>
      <read>b</read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

    <!-- =====================================================
         ACEITAÇÃO: pilha = Z (todos A's desempilhados)
         ===================================================== -->

    <!-- q3: fim da entrada, topo=Z → ACEITA (n >= 2) -->
    <transition>
      <from>3</from>
      <to>9</to>
      <read></read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

    <!-- q4: fim da entrada, topo=Z → ACEITA (n = 1) -->
    <transition>
      <from>4</from>
      <to>9</to>
      <read></read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

    <!-- q4: mais 'b' mas pilha já em Z → rejeita -->
    <transition>
      <from>4</from>
      <to>10</to>
      <read>b</read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

    <!-- =====================================================
         ESTADOS EXTRAS q5-q8: intermediários adicionais
         para enriquecer a máquina (requisito de >8 estados)
         Usados para detectar entradas com 'a' após 'b' ou
         outros casos de fronteira.
         ===================================================== -->

    <!-- q5: recebe 'a' extra após início de desempilhamento -->
    <transition>
      <from>5</from>
      <to>10</to>
      <read>a</read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

    <!-- q6, q7, q8: estados de passagem para casos de fronteira -->
    <transition>
      <from>6</from>
      <to>10</to>
      <read>b</read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

    <transition>
      <from>7</from>
      <to>10</to>
      <read>a</read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

    <transition>
      <from>8</from>
      <to>10</to>
      <read>b</read>
      <pop>Z</pop>
      <push>Z</push>
    </transition>

  </automaton>
</structure>

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Máquina de Turing com Múltiplas Fitas (2 fitas)
  Problema: Reconhecimento de palíndromos sobre {a, b}
  AV2 — Teoria da Computabilidade — CESUPA 01/2026

  Para abrir: JFLAP > File > Open > palindromo.jff
  Para testar: Input > Enter Input
  Para rastrear: Input > Step by State
-->
<structure>
  <type>multi-tape turing machine</type>
  <automaton>

    <!-- ESTADOS -->
    <state id="0" name="q0" x="80"  y="200">
      <initial/>
    </state>
    <state id="1" name="q1" x="240" y="200"/>
    <state id="2" name="q2" x="400" y="200"/>
    <state id="3" name="q3" x="400" y="340"/>
    <state id="4" name="q4" x="560" y="200"/>
    <state id="5" name="q5" x="560" y="340"/>
    <state id="6" name="q6" x="720" y="200"/>
    <state id="7" name="q7" x="720" y="340"/>
    <state id="8" name="q8" x="880" y="200"/>
    <state id="9" name="q_aceita" x="880" y="340">
      <final/>
    </state>
    <state id="10" name="q_rejeita" x="560" y="480"/>

    <!-- =====================================================
         FASE 1: Cópia reversa
         q0 trata o primeiro símbolo; q1 mantém a cópia.
         ===================================================== -->

    <transition>
      <from>0</from>
      <to>1</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">R</move>
      <read tape="2"> </read>
      <write tape="2">a</write>
      <move tape="2">L</move>
    </transition>
    <transition>
      <from>0</from>
      <to>1</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">R</move>
      <read tape="2"> </read>
      <write tape="2">b</write>
      <move tape="2">L</move>
    </transition>
    <transition>
      <from>0</from>
      <to>7</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>1</from>
      <to>1</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">R</move>
      <read tape="2"> </read>
      <write tape="2">a</write>
      <move tape="2">L</move>
    </transition>
    <transition>
      <from>1</from>
      <to>1</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">R</move>
      <read tape="2"> </read>
      <write tape="2">b</write>
      <move tape="2">L</move>
    </transition>
    <transition>
      <from>1</from>
      <to>2</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">R</move>
    </transition>

    <!-- =====================================================
         FASE 2: Reposicionamento
         q2 avança F2; q3 recua F1 até o início.
         ===================================================== -->

    <transition>
      <from>2</from>
      <to>2</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">R</move>
    </transition>
    <transition>
      <from>2</from>
      <to>3</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">L</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">S</move>
    </transition>
    <transition>
      <from>2</from>
      <to>3</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">L</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>3</from>
      <to>3</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">L</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">S</move>
    </transition>
    <transition>
      <from>3</from>
      <to>3</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">L</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">S</move>
    </transition>
    <transition>
      <from>3</from>
      <to>3</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">L</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">S</move>
    </transition>
    <transition>
      <from>3</from>
      <to>3</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">L</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">S</move>
    </transition>
    <transition>
      <from>3</from>
      <to>4</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">R</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">S</move>
    </transition>
    <transition>
      <from>3</from>
      <to>4</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">R</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">S</move>
    </transition>

    <!-- =====================================================
         FASE 3: Comparação
         q4 inicia; q5/q6 alternam conforme os símbolos lidos.
         ===================================================== -->

    <transition>
      <from>4</from>
      <to>5</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">R</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">R</move>
    </transition>
    <transition>
      <from>4</from>
      <to>6</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">R</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">R</move>
    </transition>
    <transition>
      <from>4</from>
      <to>8</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>5</from>
      <to>5</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">R</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">R</move>
    </transition>
    <transition>
      <from>5</from>
      <to>6</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">R</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">R</move>
    </transition>
    <transition>
      <from>5</from>
      <to>8</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>6</from>
      <to>6</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">R</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">R</move>
    </transition>
    <transition>
      <from>6</from>
      <to>5</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">R</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">R</move>
    </transition>
    <transition>
      <from>6</from>
      <to>8</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <!-- =====================================================
         FASE 4: Fecho
         q7 trata a cadeia vazia; q8 encerra a comparação.
         ===================================================== -->

    <transition>
      <from>7</from>
      <to>9</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>8</from>
      <to>9</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

  </automaton>
</structure>

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Máquina de Turing com Múltiplas Fitas (2 fitas)
  Problema: Reconhecimento de palíndromos sobre {a, b}
  AV2 — Teoria da Computabilidade — CESUPA 01/2026

  Para abrir: JFLAP > File > Open > palindromo.jff
  Para testar: Input > Enter Input
  Para rastrear: Input > Step by State
-->
<structure>
  <type>multi-tape turing machine</type>
  <automaton>

    <!-- ESTADOS -->
    <state id="0" name="q0" x="80"  y="200">
      <initial/>
    </state>
    <state id="1" name="q1" x="240" y="200"/>
    <state id="2" name="q2" x="400" y="200"/>
    <state id="3" name="q3" x="400" y="340"/>
    <state id="4" name="q4" x="560" y="200"/>
    <state id="5" name="q5" x="560" y="340"/>
    <state id="6" name="q6" x="720" y="200"/>
    <state id="7" name="q7" x="720" y="340"/>
    <state id="8" name="q8" x="880" y="200"/>
    <state id="9" name="q_aceita" x="880" y="340">
      <final/>
    </state>
    <state id="10" name="q_rejeita" x="560" y="480"/>

    <!-- =====================================================
         FASE 1: Cópia reversa (estados q0, auto-laço)
         Fita1 lê símbolo e move R; Fita2 escreve e move L
         Formato de transição: leitura1;escrita1;dir1;leitura2;escrita2;dir2
         ===================================================== -->

    <!-- q0 self-loop: lê 'a' na F1, copia 'a' na F2 -->
    <transition>
      <from>0</from>
      <to>0</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">R</move>
      <read tape="2"> </read>
      <write tape="2">a</write>
      <move tape="2">L</move>
    </transition>

    <!-- q0 self-loop: lê 'b' na F1, copia 'b' na F2 -->
    <transition>
      <from>0</from>
      <to>0</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">R</move>
      <read tape="2"> </read>
      <write tape="2">b</write>
      <move tape="2">L</move>
    </transition>

    <!-- q0 → q1: leu branco na F1 (fim da entrada) -->
    <transition>
      <from>0</from>
      <to>1</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">R</move>
    </transition>

    <!-- =====================================================
         FASE 2a: Avança F2 até o início do conteúdo copiado
         q1: move F2 para a direita enquanto vê o conteúdo
         ===================================================== -->

    <!-- q1: encontrou símbolo em F2 → vai para q3 (início da comparação) -->
    <transition>
      <from>1</from>
      <to>3</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">R</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>1</from>
      <to>3</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">R</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">S</move>
    </transition>

    <!-- q1 → q2: F2 ainda em branco, precisa retroceder F1 -->
    <transition>
      <from>1</from>
      <to>2</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">L</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <!-- =====================================================
         FASE 2b: Retorno de F1 ao início
         q2: F1 recua para a esquerda
         ===================================================== -->

    <transition>
      <from>2</from>
      <to>2</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">L</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>2</from>
      <to>2</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">L</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <!-- q2 → q3: F1 chegou ao início (leu branco) -->
    <transition>
      <from>2</from>
      <to>3</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">R</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <!-- =====================================================
         FASE 3: Comparação
         q3/q4: lê F1 e F2 simultaneamente
         ===================================================== -->

    <!-- Símbolos iguais: a = a -->
    <transition>
      <from>3</from>
      <to>4</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">R</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">R</move>
    </transition>

    <!-- Símbolos iguais: b = b -->
    <transition>
      <from>3</from>
      <to>4</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">R</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">R</move>
    </transition>

    <!-- Loop de comparação q4 -->
    <transition>
      <from>4</from>
      <to>4</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">R</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">R</move>
    </transition>

    <transition>
      <from>4</from>
      <to>4</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">R</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">R</move>
    </transition>

    <!-- Fim simultâneo: ambas leram branco → ACEITA -->
    <transition>
      <from>3</from>
      <to>9</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>4</from>
      <to>9</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <!-- Símbolos diferentes → REJEITA -->
    <transition>
      <from>3</from>
      <to>10</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">S</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>3</from>
      <to>10</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">S</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>4</from>
      <to>10</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">S</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>4</from>
      <to>10</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">S</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">S</move>
    </transition>

    <!-- Fim assimétrico → REJEITA -->
    <transition>
      <from>3</from>
      <to>10</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2">a</read>
      <write tape="2">a</write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>3</from>
      <to>10</to>
      <read tape="1"> </read>
      <write tape="1"> </write>
      <move tape="1">S</move>
      <read tape="2">b</read>
      <write tape="2">b</write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>3</from>
      <to>10</to>
      <read tape="1">a</read>
      <write tape="1">a</write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

    <transition>
      <from>3</from>
      <to>10</to>
      <read tape="1">b</read>
      <write tape="1">b</write>
      <move tape="1">S</move>
      <read tape="2"> </read>
      <write tape="2"> </write>
      <move tape="2">S</move>
    </transition>

  </automaton>
</structure>
